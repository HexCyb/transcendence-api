{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "transcendence-api",
    "Audience": "transcendence-spa",
    "LifetimeMinutes": 60
  },
  "RateLimiting": {
    "AuthPerMinute": 10
  },
  "Cors": {
    "Origins": [ "https://localhost:8443" ]
  }
}
